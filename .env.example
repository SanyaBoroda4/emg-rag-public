# Copy to .env and fill in real values. .env is never committed.

# Postgres (emg_rag_db container, localhost-only on port 5433)
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DB=emg_rag
PG_USER=emg_rag
PG_PASSWORD=change-me

# Moraware bridge API
BRIDGE_BASE_URL=
BRIDGE_API_KEY=

# Anthropic API (embeddings / generation, later work orders)
ANTHROPIC_API_KEY=

# Voyage AI (embeddings + rerank fallback)
VOYAGE_API_KEY=

# Read-only role for the text-to-SQL lane (scripts/setup_ro_role.py)
PG_RO_PASSWORD=change-me-too

# Reranker backend: "local" (cross-encoder, needs ~600MiB RSS) or "voyage"
# (rerank-2.5-lite API). The 2GB server MUST use voyage (gate: scripts/measure_reranker.py).
RERANK_BACKEND=voyage
RERANK_ENABLED=1
